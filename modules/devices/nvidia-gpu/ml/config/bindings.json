    "joint_gpu": {
      "name": "多指标联合 · 自定义指标组",
      "kind": "multivariate",
      "required": [
        "gpu_temp",
        "power",
        "sm_clock",
        "util"
      ],
      "targets": [
        "gpu_temp",
        "power",
        "sm_clock",
        "util"
      ],
      "features": [],
      "algorithms": [
        "joint_pca",
        "joint_iforest"
      ],
      "description": "标准化PCA联合行为检测，输出重构参考值、残差及潜空间偏离；不是温度预测"
    }
  }
}
